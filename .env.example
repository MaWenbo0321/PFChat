# Required application secrets
DASHSCOPE_API_KEY=replace-with-a-new-dashscope-api-key
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional DashScope overrides
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_API_URL=https://llm-26cli7e69esmbtok.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# MySQL connection used by the Go backend
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=im_system
MYSQL_USER=im_user
MYSQL_PASSWORD=replace-with-a-strong-database-password

# MySQL container initialization (used only when the data volume is first created)
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
TZ=Asia/Shanghai

# Used only when no administrator exists yet
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
